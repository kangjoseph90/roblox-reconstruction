{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "RCR acquisition and recovery report",
  "type": "object",
  "required": ["schema", "operation", "created_at", "network_used", "artifacts", "scripts", "errors", "coverage", "summary"],
  "properties": {
    "schema": {"const": "rcr-report/v1"},
    "operation": {"enum": ["acquire", "extract"]},
    "created_at": {"type": "string"}, "network_used": {"type": "boolean"},
    "artifacts": {"type": "array", "items": {"type": "object"}},
    "errors": {"type": "array"},
    "coverage": {"type": "object", "required": ["scope", "game_completeness", "runtime_executed"],
      "properties": {"scope": {"type": "string"}, "game_completeness": {"type": "string"}, "runtime_executed": {"const": false}}},
    "scripts": {"type": "array", "items": {
      "type": "object", "required": ["id", "artifact_id", "class", "scope", "instance_path", "recovery"],
      "properties": {
        "id": {"type": "string"}, "artifact_id": {"type": "string"}, "class": {"type": "string"},
        "scope": {"type": "string"}, "instance_path": {"type": "array", "items": {"type": "string"}},
        "source": {"type": "string"}, "source_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
        "recovery": {"type": "string"}, "validation": {"type": "object"},
        "verification": {"type": "object", "required": ["syntax", "cfg", "behavior"],
          "properties": {
            "syntax": {"enum": ["SYNTAX_VALID", "SYNTAX_INVALID", "SYNTAX_UNVERIFIED", "NOT_CHECKED"]},
            "cfg": {"enum": ["CFG_VALIDATED", "UNVERIFIED", "CFG_MISMATCH", "NOT_CHECKED", "CFG_UNVERIFIED"],
              "description": "Current reports use UNVERIFIED for an inconclusive check. CFG_UNVERIFIED is accepted for historical v0.3.2 reports; it is not emitted by the current verifier."},
            "behavior": {"enum": ["BEHAVIOR_VERIFIED", "BEHAVIOR_FAILED", "NOT_TESTED"]}
          }},
        "recovery_warnings": {"type": "array", "items": {"type": "string"}},
        "cfg_audit": {"type": "object"}
      }
    }},
    "summary": {"type": "object", "required": ["status", "source_files"],
      "properties": {"status": {"type": "string"}, "source_files": {"type": "integer", "minimum": 0}}}
  }
}
