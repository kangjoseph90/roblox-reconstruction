{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Integrated Roblox run or replay report",
  "type": "object",
  "required": ["schema", "operation", "created_at", "new_live_capture", "summary", "artifacts", "scripts", "errors"],
  "properties": {
    "schema": {"const": "rcr-run/v1"},
    "operation": {"enum": ["run", "replay", "regression"]},
    "created_at": {"type": "string"},
    "new_live_capture": {"type": "boolean"},
    "profile": {"type": "string"},
    "extraction_report": {"type": "string"},
    "artifacts": {"type": "array"},
    "scripts": {"type": "array"},
    "errors": {"type": "array"},
    "summary": {
      "type": "object", "required": ["status", "source_files"],
      "properties": {
        "status": {"type": "string"},
        "source_files": {"type": "integer", "minimum": 0},
        "source_candidates": {"type": "integer", "minimum": 0},
        "semantic_equivalence": {"enum": ["not_tested"]}
      }
    }
  }
}
