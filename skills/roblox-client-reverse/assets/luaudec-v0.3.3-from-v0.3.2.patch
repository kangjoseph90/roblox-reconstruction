 }
 
+// Condition builders may simplify by truthiness. A LOADB materialization or
+// value-producing and/or must preserve the actual Luau value (nil/false/0/
+// strings differ), not just whether an enclosing if would take the branch.
+bool isBooleanValue(const ExprP& e)
+{
+    if (e->kind == ExprKind::True || e->kind == ExprKind::False)
+        return true;
+    if (e->kind == ExprKind::UnOp && e->str == "not")
+        return true;
+    if (e->kind == ExprKind::BinOp)
+    {
+        if (e->str == "==" || e->str == "~=" || e->str == "<" || e->str == "<=" || e->str == ">" || e->str == ">=")
+            return true;
+        if (e->str == "and" || e->str == "or")
+            return isBooleanValue(e->a) && isBooleanValue(e->b);
+    }
+    return false;
+}
+
+ExprP booleanValue(const ExprP& e)
+{
+    return isBooleanValue(e) ? e : mkUnOp("not", mkUnOp("not", e));
+}
