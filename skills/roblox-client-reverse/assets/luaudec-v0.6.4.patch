+void analyzeCFG(CFG& cfg)
+{
+    const size_t n = cfg.blocks.size();
+    cfg.reachable.assign(n, 0);
+    if (!n)
+        return;
+    std::vector<int> work{0};
+    while (!work.empty())
+    {
+        int b = work.back();
+        work.pop_back();
+        if (cfg.reachable[b])
+            continue;
+        cfg.reachable[b] = 1;
+        for (const Edge& e : cfg.blocks[b].succs)
+            work.push_back(e.to);
+    }
+    cfg.dominators.assign(n, cfg.reachable);
+    cfg.dominators[0].assign(n, 0);
+    cfg.dominators[0][0] = 1;
+    bool changed = true;
+    while (changed)
+    {
+        changed = false;
+        for (size_t b = 1; b < n; ++b)
+        {
+            if (!cfg.reachable[b])
+                continue;
+            std::vector<char> next(n, 1);
+            for (int pred : cfg.blocks[b].preds)
+                if (cfg.reachable[pred])
+                    for (size_t j = 0; j < n; ++j)
+                        next[j] &= cfg.dominators[pred][j];
+            next[b] = 1;
+            if (next != cfg.dominators[b])
+                cfg.dominators[b].swap(next), changed = true;
+        }
+    }
+    cfg.postDominators.assign(n + 1, std::vector<char>(n + 1, 1));
+    cfg.postDominators[n].assign(n + 1, 0);
+    cfg.postDominators[n][n] = 1;
+    // Nodes in nonterminating components must not acquire arbitrary postdominators.
+    std::vector<char> reachesExit(n, 0);
+    for (size_t b = 0; b < n; ++b)
+        if (cfg.reachable[b] && cfg.blocks[b].succs.empty())
+            work.push_back(int(b));
+    while (!work.empty())
+    {
+        int b = work.back(); work.pop_back();
+        if (reachesExit[b]) continue;
+        reachesExit[b] = 1;
+        for (int pred : cfg.blocks[b].preds)
+            if (cfg.reachable[pred]) work.push_back(pred);
+    }
+    for (size_t b = 0; b < n; ++b)
+        if (!reachesExit[b])
+        {
+            cfg.postDominators[b].assign(n + 1, 0);
+            cfg.postDominators[b][b] = 1;
+        }
+    changed = true;
+    while (changed)
+    {
+        changed = false;
+        for (size_t b = n; b-- > 0;)
+        {
+            if (!cfg.reachable[b] || !reachesExit[b]) continue;
+            std::vector<char> next(n + 1, 1);
+            if (cfg.blocks[b].succs.empty())
+                next = cfg.postDominators[n];
+            else
+                for (const Edge& e : cfg.blocks[b].succs)
+                    for (size_t j = 0; j <= n; ++j)
+                        next[j] &= cfg.postDominators[e.to][j];
+            next[b] = 1;
+            if (next != cfg.postDominators[b])
+                cfg.postDominators[b].swap(next), changed = true;
+        }
+    }
 }
 
