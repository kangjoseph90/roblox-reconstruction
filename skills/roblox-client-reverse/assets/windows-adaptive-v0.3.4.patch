+            vector = reader.read(q(reader.read(parent + field, 8), 0), 24)
+            begin, end = q(vector, 0), q(vector, 8)
+            if not pointer(begin) or not begin < end <= begin + 8 * 1024**2 or (end - begin) % stride: return False
